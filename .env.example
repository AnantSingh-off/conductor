# Environment Variables Example

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# AI Providers
AI_PROVIDER_API_KEY=your_ai_api_key_here
DEFAULT_AI_MODEL=gpt-4-vision-preview

# App Configuration
APP_NAME=Conductor
APP_DESCRIPTION=AI-assisted creative workflow orchestration platform

# File Upload
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/*,application/pdf,text/*

# Generation
DEFAULT_ASPECT_RATIO=1:1
GENERATION_TIMEOUT_SECONDS=300

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
ENABLE_SERVER_LOGS=true